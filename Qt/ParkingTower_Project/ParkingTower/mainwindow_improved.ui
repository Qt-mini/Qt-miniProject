  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget { background-color: #F4F5F7; color: #17191C; }
QLabel { background: transparent; }
QPushButton { background-color: white; border: 1px solid #D9DDE3; border-radius: 14px; padding: 8px 18px; }
QPushButton:hover { background-color: #F0F4FF; border: 2px solid #4C7DFF; }
QPushButton:pressed { background-color: #E5ECFF; }
QLineEdit { background-color: white; border: 2px solid #D9DDE3; border-radius: 12px; padding: 8px 14px; selection-background-color: #4C7DFF; }
QListWidget { background-color: white; border: 2px solid #D9DDE3; border-radius: 12px; padding: 8px; }
QListWidget::item { padding: 8px; }
QFrame#card { background-color: white; border: 1px solid #E0E3E8; border-radius: 18px; }
QFrame#floorCard { background-color: white; border: 1px solid #E0E3E8; border-radius: 18px; }
QFrame#floorRow { background-color: #F7F8FA; border-radius: 9px; }
QLabel#lblSlot8, QLabel#lblSlot7, QLabel#lblSlot6, QLabel#lblSlot5, QLabel#lblSlot4, QLabel#lblSlot3, QLabel#lblSlot2, QLabel#lblSlot1 { background-color: #55B77A; border-radius: 9px; min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px; }
QPushButton#btnEntry, QPushButton#btnExit { border: none; border-radius: 18px; font-size: 26pt; font-weight: 700; }
QPushButton#btnEntry { background-color: #315FEA; color: white; }
QPushButton#btnEntry:hover { background-color: #234ED0; }
QPushButton#btnExit { background-color: #24282E; color: white; }
QPushButton#btnExit:hover { background-color: #111418; }
QPushButton#btnEntryRequest, QPushButton#btnExitRequest, QPushButton#btnExitSearch, QPushButton#btnPaymentRequest { background-color: #315FEA; color: white; border: none; border-radius: 12px; font-weight: 700; }
QPushButton#btnEntryToHome, QPushButton#btnExitToHome, QPushButton#btnPaymentToExit, QPushButton#btnPaymentToHome { background-color: transparent; border: 1px solid #D9DDE3; }
QPushButton#btnEntryRequest:hover, QPushButton#btnExitRequest:hover, QPushButton#btnExitSearch:hover, QPushButton#btnPaymentRequest:hover { background-color: #234ED0; }
  </string>
